# Copy to .env.development.local (dev) and fill in. Never commit real values.
# `supabase status` prints the local URL and keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by /api/login to start a session; nothing else.
SUPABASE_SECRET_KEY=
# Server-only.
ANTHROPIC_API_KEY=
# Server-only. Reschedule → Week runs on OpenRouter (falls back to Claude without it).
OPENROUTER_API_KEY=
# Server-only. The passphrase the login asks for (online, set in Vercel). Unset: a
# local dev server is open, a deployed one lets nobody in.
ACCESS_CODE=
